[Desktop Entry]
Type=Application
Name=Comic and Scroll Reader
Comment=Read image folders and files as a continuous scrolling comic
Exec=comic-scroll-reader %F
Icon=comic-scroll-reader
Terminal=false
Categories=Graphics;Viewer;2DGraphics;RasterInfo;
MimeType=inode/directory;application/pdf;image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/avif;image/x-tga;
StartupNotify=false

